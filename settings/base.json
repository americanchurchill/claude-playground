{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TEAMMATE_MODE": "tmux"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(cat:*)",
      "Bash(claude --version:*)",
      "Bash(claude mcp list:*)",
      "Bash(column:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(du:*)",
      "Bash(fd:*)",
      "Bash(file:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(locate:*)",
      "Bash(ls:*)",
      "Bash(mdfind:*)",
      "Bash(pdftotext:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(whereis:*)",
      "Bash(which:*)",
      "WebSearch"
    ]
  },
  "skillOverrides": {
    "code-review": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); model=$(echo \"$input\" | jq -r '.model.display_name'); cost=$(echo \"$input\" | jq -r '.cost.total_cost_usd // 0'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); [ -n \"$used\" ] && printf \"Context: %.1f%% | $%.2f | %s | %s\" \"$used\" \"$cost\" \"$model\" \"$dir\" || printf \"Context: -- | $%.2f | %s | %s\" \"$cost\" \"$model\" \"$dir\""
  },
  "extraKnownMarketplaces": {
    "claude-playground": {
      "source": {
        "source": "github",
        "repo": "winsthuang/claude-playground"
      }
    },
    "hazel-skills": {
      "source": {
        "source": "github",
        "repo": "winsthuang/hazel-skills"
      }
    }
  },
  "enabledPlugins": {
    "winston-output-styles@claude-playground": true,
    "de-ai-ify@hazel-skills": true,
    "slack-respond@hazel-skills": true
  }
}
