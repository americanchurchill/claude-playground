{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TEAMMATE_MODE": "tmux"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(cat:*)",
      "Bash(claude --version:*)",
      "Bash(claude mcp list:*)",
      "Bash(column:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(du:*)",
      "Bash(env:*)",
      "Bash(fd:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(locate:*)",
      "Bash(ls:*)",
      "Bash(mdfind:*)",
      "Bash(pdftotext:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(sleep:*)",
      "Bash(sort:*)",
      "Bash(sqlite3:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(whereis:*)",
      "Bash(which:*)",
      "WebSearch"
    ]
  },
  "skillOverrides": {
    "JA-update": "off",
    "code-review": "off",
    "competitive-analysis": "off",
    "data-context-extractor": "off",
    "data-exploration": "off",
    "data-validation": "off",
    "data-visualization": "off",
    "documentation": "off",
    "feature-spec": "off",
    "financial-statements": "off",
    "interactive-dashboard-builder": "off",
    "meeting-followup": "off",
    "metrics-tracking": "off",
    "roadmap-management": "off",
    "sigma-dashboard": "off",
    "spawn-team": "off",
    "sql-queries": "off",
    "stakeholder-comms": "off",
    "tech-debt": "off",
    "testing-strategy": "off",
    "trades": "off",
    "tufte": "off",
    "update-manual-okrs": "off",
    "update-sprints": "off",
    "user-research-synthesis": "off",
    "variance-analysis": "off",
    "verified-snowflake": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); model=$(echo \"$input\" | jq -r '.model.display_name'); cost=$(echo \"$input\" | jq -r '.cost.total_cost_usd // 0'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); [ -n \"$used\" ] && printf \"Context: %.1f%% | $%.2f | %s | %s\" \"$used\" \"$cost\" \"$model\" \"$dir\" || printf \"Context: -- | $%.2f | %s | %s\" \"$cost\" \"$model\" \"$dir\""
  }
}
